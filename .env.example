# Names only. Never commit values. On AWS these live in SSM Parameter Store (/firefighter/*) and
# in /etc/firefighter/*.env on the instances (written by the setup scripts, chmod 600).

# --- keys you provide -------------------------------------------------------------
# OpenAI (organizer): paste into TrueForge UI -> Settings -> Models. Not used by our code.
# Daytona (your own; Sandboxes + Snapshots write): TrueForge UI -> Settings -> Sandbox providers.
HF_TOKEN=                 # Hugging Face read token (optional; Qwen2.5-7B is ungated)
GITHUB_TOKEN=             # optional: fine-grained PAT, contents:write on GITHUB_REPO (audit trail)
GITHUB_REPO=              # optional: owner/repo that receives prod/vllm.yaml commits
PROMETHEUS_URL=           # optional: your existing Prometheus; otherwise one runs on the control node
PROMETHEUS_BEARER_TOKEN=  # optional, if your Prometheus needs auth (or PROMETHEUS_USER/PASSWORD)

# --- generated by infra/aws/secrets.sh ----------------------------------------------
CONTROLLER_TOKEN=         # MCP server / chaos / Prometheus -> node controllers
MCP_AUTH_TOKEN=           # TrueForge -> MCP server (registered as connector header auth)

# --- agent registration (infra/node/ops.sh register-agent) --------------------------
AGENT_MODEL=              # TrueForge model FQN, e.g. openai/<model-id> as shown in Settings -> Models
AGENT_REASONING_EFFORT=   # optional, only for models that support it (e.g. medium)
