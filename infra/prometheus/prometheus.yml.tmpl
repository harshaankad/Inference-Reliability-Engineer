# Scrape config for the Firefighter fleet. Rendered by infra/node/setup_control.sh:
#   __PROD_SCHEME__/__PROD_TARGET__, __SHADOW_SCHEME__/__SHADOW_TARGET__  from the controller URLs
#   (AWS private IP -> http + ip:9000; Lightning Studio -> https + 9000-<id>.cloudspaces.litng.ai)
#   /etc/prometheus/controller_token  file containing CONTROLLER_TOKEN
# If you already run Prometheus, add these jobs to it. Job names matter: the MCP server
# queries job="vllm-prod" (override with PROMETHEUS_JOB_PROD).
global:
  scrape_interval: 5s
  evaluation_interval: 15s

scrape_configs:
  - job_name: vllm-prod
    scheme: __PROD_SCHEME__
    metrics_path: /slots/prod/metrics
    authorization: {type: Bearer, credentials_file: /etc/prometheus/controller_token}
    static_configs: [{targets: ["__PROD_TARGET__"], labels: {role: prod}}]

  - job_name: vllm-shadow
    scheme: __SHADOW_SCHEME__
    metrics_path: /slots/shadow/metrics
    authorization: {type: Bearer, credentials_file: /etc/prometheus/controller_token}
    static_configs: [{targets: ["__SHADOW_TARGET__"], labels: {role: shadow}}]

  - job_name: gpu-prod
    scheme: __PROD_SCHEME__
    metrics_path: /gpu/metrics
    authorization: {type: Bearer, credentials_file: /etc/prometheus/controller_token}
    static_configs: [{targets: ["__PROD_TARGET__"], labels: {role: prod}}]

  - job_name: gpu-shadow
    scheme: __SHADOW_SCHEME__
    metrics_path: /gpu/metrics
    authorization: {type: Bearer, credentials_file: /etc/prometheus/controller_token}
    static_configs: [{targets: ["__SHADOW_TARGET__"], labels: {role: shadow}}]
