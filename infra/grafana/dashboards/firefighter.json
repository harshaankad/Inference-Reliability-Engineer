{
 "uid": "firefighter",
 "title": "Inference Firefighter: vLLM on L4",
 "tags": [
  "vllm",
  "firefighter"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "annotations": {
  "list": [
   {
    "name": "prod deploy / restart",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "enable": true,
    "iconColor": "orange",
    "expr": "changes(process_start_time_seconds{job=\"vllm-prod\"}[1m]) > 0",
    "step": "30s",
    "titleFormat": "prod vLLM restarted (config change)"
   },
   {
    "name": "shadow deploy / restart",
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "enable": true,
    "iconColor": "blue",
    "expr": "changes(process_start_time_seconds{job=\"vllm-shadow\"}[1m]) > 0",
    "step": "30s",
    "titleFormat": "shadow vLLM restarted (experiment)"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Production: what users feel",
   "id": 2,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Time to first token (SLO p95 \u2264 4 s)",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 4
       }
      ]
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "thresholdsStyle": {
       "mode": "line+area"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{job=\"vllm-prod\"}[1m])))",
     "legendFormat": "p95",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{job=\"vllm-prod\"}[1m])))",
     "legendFormat": "p50",
     "refId": "B"
    }
   ]
  },
